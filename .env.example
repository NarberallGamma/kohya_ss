# Copy to .env next to docker-compose.yaml
# Bind is loopback only. GUI port maps to 7860 in the container.

KOHYA_PORT=7861
TENSORBOARD_PORT=6006

# Checkpoints and LoRA on the host. Default is ./models in this repo.
# Shared WebUI tree, if needed later:
# MODELS_HOST_PATH=../stable-diffusion-webui-docker/data/models
MODELS_HOST_PATH=./models
